# ==============================================================
# PULSEFIT - WORKOUT TRACKER ENVIRONMENT CONFIGURATION
# ==============================================================

# Application port (mapped on host)
PORT=8080

# MongoDB port (mapped on host)
MONGO_PORT=27018

# MongoDB connection string
MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=workout_tracker

# "development" or "production". Production refuses to start with a weak JWT_SECRET,
# disables /docs, and turns demo login off unless ALLOW_DEV_LOGIN=true is set.
ENVIRONMENT=development

# JWT Security Secret. REQUIRED in production (min 32 chars). Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Leave empty in local development to use an ephemeral random secret.
JWT_SECRET=

# Shared demo account login (anyone can use it). Defaults to on in development, off in production.
# ALLOW_DEV_LOGIN=false

# Public Frontend URL / Custom Domain (used for OAuth redirects and CORS)
# For local dev: http://localhost:8080 or http://localhost:5173
# For production: https://YOUR_CUSTOM_DOMAIN.com (or set CUSTOM_DOMAIN=yourdomain.com)
FRONTEND_URL=http://localhost:8080
# CUSTOM_DOMAIN=

# ==============================================================
# GOOGLE OAUTH 2.0 CREDENTIALS
# ==============================================================
# To configure Google Sign-In:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a project and configure the OAuth Consent Screen
# 3. Create "OAuth 2.0 Client ID" with application type "Web application"
# 4. Authorized JavaScript origins:
#      http://localhost:8080
#      http://localhost:5173
# 5. Authorized redirect URIs:
#      http://localhost:8080/api/auth/google/callback
# 6. Paste your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
