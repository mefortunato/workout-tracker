# ==============================================================
# PULSEFIT - WORKOUT TRACKER ENVIRONMENT CONFIGURATION
# ==============================================================

# Application port (mapped on host)
PORT=8080

# MongoDB port (mapped on host)
MONGO_PORT=27018

# MongoDB connection string
MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=workout_tracker

# JWT Security Secret (generate a strong random string in production)
JWT_SECRET=super-secret-workout-tracker-token-key-change-in-prod-2026

# Public Frontend URL (used for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:8080

# ==============================================================
# GOOGLE OAUTH 2.0 CREDENTIALS
# ==============================================================
# To configure Google Sign-In:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a project and configure the OAuth Consent Screen
# 3. Create "OAuth 2.0 Client ID" with application type "Web application"
# 4. Authorized JavaScript origins:
#      http://localhost:8080
#      http://localhost:5173
# 5. Authorized redirect URIs:
#      http://localhost:8080/api/auth/google/callback
# 6. Paste your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
